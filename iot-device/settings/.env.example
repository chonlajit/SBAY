# ==========================================
# SBAY Smart Bin - Environment Configuration
# ให้ก็อปปี้ไฟล์นี้ไปเปลี่ยนชื่อเป็น .env และแก้ไขค่าด้านล่าง
# ==========================================

# --- การเชื่อมต่อ Backend ---
# (จำเป็นต้องใส่) รหัสลับสำหรับยืนยันตัวตนของตู้นี้
DEVICE_SECRET=your_secret_key_here

# (จำเป็นต้องใส่) URL ของเซิร์ฟเวอร์ Backend
BACKEND_URL=http://localhost:8070

# --- ข้อมูลประจำตู้ ---
# รหัสประจำตู้ (ถ้าไม่ใส่จะใช้ค่าเริ่มต้น BIN-001)
DEVICE_ID=BIN-001

# ชื่อตู้ที่จะแสดงใน Dashboard (เช่น "ตู้หน้าคณะวิศวะ")
DEVICE_NAME=Smart Bin

# สถานที่ตั้งตู้ที่จะแสดงใน Dashboard (เช่น "ชั้น 1 อาคาร A")
DEVICE_LOCATION=SBAY Location

