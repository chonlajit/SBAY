# ============================================
# SBAY Smart Bin - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# --- Cloudflare Tunnel ---
# Get this from Cloudflare Zero Trust Dashboard
# https://one.dash.cloudflare.com/ -> Networks -> Tunnels
CF_TUNNEL_TOKEN=your_tunnel_token_here

# --- Windows Host IP ---
# Used by Nginx to reverse proxy to the host machine
# Usually "host-gateway" for Docker Desktop on Windows
WINDOWS_IP=host-gateway

# --- IoT Device Secret Key ---
# Shared secret between backend and IoT devices
# Used in X-Device-Secret header for device authentication
# Generate with: openssl rand -base64 32
DEVICE_SECRET=your_secret_key_here

# --- SMTP Email (for OTP) ---
# Gmail account for sending OTP verification emails
# For SMTP_PASSWORD, use Gmail App Password (not your real password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# --- Mongo Express ---
# Database admin panel credentials
ME_USERNAME=sbay_admin
ME_PASSWORD=SBAY@adminpass277ac478#!
